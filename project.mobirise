                "margin-bottom": "2rem"
              }
            },
            ".card-title, .card-box": {
              "color": "#000000"
            },
            ".icon-text": {
              "color": "#8e8d8a"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#4479d9"
